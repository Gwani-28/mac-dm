{
  "manifest_version": 3,
  "name": "Mac DM — 다운로드 가로채기",
  "version": "0.4.0",
  "description": "크롬 다운로드를 Mac DM 데몬으로 보내 분할 다운로드합니다.",
  "key": "",
  "icons": { "32": "icons/icon32.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "32": "icons/icon32.png" }
  },
  "permissions": [
    "downloads",
    "webRequest",
    "cookies",
    "nativeMessaging",
    "storage",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"]
}
