{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacDM",
  "version": "0.3.0",
  "identifier": "com.macdm.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mac DM — 다운로드 매니저",
        "width": 1000,
        "height": 660,
        "minWidth": 760,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"]
  }
}
